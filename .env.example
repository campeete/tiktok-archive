# ============================================================================
# tiktok-archive .env (example)
# ============================================================================
# Copy this file to .env, fill in values, and never commit the real .env.
# Every value here has a sensible default; uncomment only what you need to
# override.

# ----- Storage -------------------------------------------------------------
# "local" or "r2". Local is always primary; r2 mirrors transcripts to
# Cloudflare R2 for off-machine durability.
# TT_STORAGE_BACKEND=local

# Cloudflare R2 credentials (only needed when STORAGE_BACKEND=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=tiktok-archive
# R2_ENDPOINT=  # auto-derived from account ID; only set if you need a custom endpoint

# ----- Models --------------------------------------------------------------
# TT_WHISPER_MODEL=medium     # tiny | base | small | medium | large
# TT_WHISPER_LANGUAGE=en      # auto for detection
# TT_TAG_MODEL=qwen2.5:7b
# TT_SUMMARY_MODEL=qwen2.5:7b
# TT_QA_MODEL=qwen2.5:7b
# TT_EMBEDDING_MODEL=nomic-embed-text
# TT_OLLAMA_HOST=http://localhost:11434

# ----- Web UI --------------------------------------------------------------
# TT_WEB_HOST=127.0.0.1
# TT_WEB_PORT=5050

# ----- Worker concurrency --------------------------------------------------
# TT_WORKER_DOWNLOAD_CONCURRENCY=1     # don't increase; TikTok will rate-limit
# TT_WORKER_TRANSCRIBE_CONCURRENCY=1   # whisper is single-threaded
# TT_WORKER_TAG_CONCURRENCY=2
# TT_WORKER_EMBED_CONCURRENCY=2

# ----- Job queue retries ---------------------------------------------------
# TT_JOB_MAX_ATTEMPTS=3
# TT_JOB_BACKOFF_BASE_SEC=30
# TT_JOB_BACKOFF_FACTOR=3
# TT_JOB_LOCK_TIMEOUT_SEC=1800
# TT_WORKER_IDLE_SLEEP_SEC=5

# ----- yt-dlp / TikTok throttle -------------------------------------------
# TT_YTDLP_SLEEP_INTERVAL=3
# TT_YTDLP_MAX_SLEEP_INTERVAL=6
# TT_RATE_LIMIT_PAUSE_SEC=3600   # how long to pause everything after a 429/403

# ----- Creator sync --------------------------------------------------------
# TT_CREATOR_DEFAULT_DEPTH=last-6mo   # full | last-6mo | last-50
# TT_CREATOR_SYNC_INTERVAL_HOURS=24

# ----- Paths (only override if you want them outside ./data) --------------
# TT_DATA_DIR=./data
# TT_SCRATCH_DIR=./data/scratch
# TT_TRANSCRIPTS_DIR=./data/transcripts
# TT_DB_BACKUPS_DIR=./data/db-backups
# TT_DB_PATH=./data/tiktok.db
# TT_LOG_DIR=./data/logs

# ----- Logging -------------------------------------------------------------
# TT_LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# ----- Backups -------------------------------------------------------------
# TT_DB_BACKUP_RETENTION_DAYS=30
